# Visualizing the (lack of) linear relationship
erged_economic_exports %>%
ggplot(aes(x = trm_usd, y = primary_value)) +
# Softening the points helps visualize the density of the data
geom_point(alpha = 0.4, color = "grey40", size = 1.8) +
# Adding the standard error (se = TRUE) suggests the degree of uncertainty in the trend
geom_smooth(method = "lm", se = TRUE, color = "firebrick", fill = "grey90", linewidth = 1) +
scale_x_continuous(labels = label_dollar()) +
scale_y_continuous(labels = label_dollar(scale_cut = cut_short_scale())) +
labs(
title = "Exchange Rate (TRM) and Export Value Observations",
subtitle = "The dispersion suggests that the exchange rate may only have a limited influence on total export value.",
x = "Exchange Rate (TRM USD)",
y = "Export Value (USD)",
caption = "The wide gray ribbon indicates that a linear relationship might not be the most accurate fit for this data."
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
plot.subtitle = element_text(color = "grey20"),
panel.grid.minor = element_blank()
)
