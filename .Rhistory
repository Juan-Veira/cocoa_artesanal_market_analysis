linewidth = 0.5) +
scale_y_continuous(
name = "Chocolate Exports (USD)",
labels = scales::dollar,
sec.axis = sec_axis(~ . / 1000, name = "Global Cocoa Price (USD/MT)", labels = scales::dollar)
) +
