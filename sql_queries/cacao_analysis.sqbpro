lue="85"/><column index="4" value="103"/><column index="5" value="81"/><column index="6" value="70"/><column index="7" value="170"/><column index="8" value="139"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Raw_ComTrade" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="3" mode="1"/></sort><column_widths><column index="1" value="73"/><column index="2" value="71"/><column index="3" value="81"/><column index="4" value="58"/><column index="5" value="71"/><column index="6" value="55"/><column index="7" value="94"/><column index="8" value="84"/><column index="9" value="92"/><column index="10" value="72"/><column index="11" value="69"/><column index="12" value="89"/><column index="13" value="79"/><column index="14" value="87"/><column index="15" value="96"/><column index="16" value="86"/><column index="17" value="94"/><column index="18" value="120"/><column index="19" value="158"/><column index="20" value="146"/><column index="21" value="72"/><column index="22" value="300"/><column index="23" value="73"/><column index="24" value="50"/><column index="25" value="95"/><column index="26" value="92"/><column index="27" value="72"/><column index="28" value="71"/><column index="29" value="78"/><column index="30" value="90"/><column index="31" value="88"/><column index="32" value="78"/><column index="33" value="103"/><column index="34" value="106"/><column index="35" value="104"/><column index="36" value="78"/><column index="37" value="119"/><column index="38" value="78"/><column index="39" value="127"/><column index="40" value="72"/><column index="41" value="138"/><column index="42" value="85"/><column index="43" value="85"/><column index="44" value="92"/><column index="45" value="138"/><column index="46" value="79"/><column index="47" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 5">-- What is the month with the lower Colombian Cocoa Price per year?
WITH ranked AS (
	SELECT
		strftime('%Y', date) AS year,
		strftime('%m', date) AS month,
		price_usd_metric_ton,
		ROW_NUMBER() OVER (
			PARTITION BY strftime('%Y',date)
			ORDER BY price_usd_metric_ton ASC
		) AS r_number
	FROM Monthly_Colombian_Cacao
	WHERE date &lt; '2025-01-01'
)
SELECT 
	year, 
	month, 
	price_usd_metric_ton
FROM ranked
WHERE r_number = 1 AND year IS NOT NULL
ORDER BY year</sql><sql name="SQL 6">-- What is the month with the lowest Colombian Cocoa Price until december 2024?
WITH ranked AS (
	SELECT
		strftime('%Y', date) AS year,
		strftime('%m', date) AS month,
		price_usd_metric_ton,
		ROW_NUMBER() OVER (
			PARTITION BY strftime('%Y', date)
			ORDER BY price_usd_metric_ton ASC
		) AS r_number
	FROM Monthly_Colombian_Cacao
	WHERE date &lt; '2025-01-01'
)
SELECT
	month,
	COUNT(*) AS times_cheapest
FROM ranked
WHERE r_number = 1 AND year IS NOT NULL
GROUP BY month
ORDER BY times_cheapest DESC</sql><sql name="SQL 8">-- Which months typically see the highest consumer demand based on seasonal pricing trends?

WITH ranked AS (
    SELECT
        substr(observation_date, -4) AS year,
        printf('%02d', substr(observation_date, 1, instr(observation_date, '/') - 1)) AS month,   
        producer_price_index AS avg_pcu_price,
        ROW_NUMBER() OVER (
            PARTITION BY substr(observation_date, -4) 
            ORDER BY producer_price_index DESC
        ) AS r_number
		
    FROM Cleaned_Chocolate_Producer_Price
    WHERE substr(observation_date, -4) &lt; '2025'
)
SELECT
    month,
    COUNT(*) AS times_highest_demand
FROM ranked
WHERE r_number = 1
GROUP BY month
ORDER BY times_highest_demand DESC
</sql><sql name="SQL 4">-- What is the difference of Colombian Cacao Price and Global Cacao Price per yaerLocal price vs global price difference per year?
WITH global_price AS (
    SELECT 
        substr(observation_date, -4, 4) AS refyear,
        printf('%02d', substr(observation_date, 1, instr(observation_date,'/')-1)) AS refmonth,
        MAX(price_cocoa_usd_metric_ton) AS global_price
    FROM Cleaned_Global_Cacao
    GROUP BY refyear, refmonth
),
local_price AS (
    SELECT
        strftime('%Y', date) AS refyear,
        strftime('%m', date) AS refmonth,
        price_usd_metric_ton AS local_price
    FROM Monthly_Colombian_Cacao
),
comparison AS (
SELECT
    l.refyear,
    l.refmonth,
    l.local_price,
    g.global_price,
    ROUND(ABS(l.local_price - g.global_price),2) AS price_diff,
    ROUND(ABS(l.local_price / g.global_price - 1)*100,2) AS pct_diff
FROM local_price l
LEFT JOIN global_price g
    ON l.refyear = g.refyear
   AND l.refmonth = g.refmonth
WHERE  g.global_price IS NOT NULL
ORDER BY l.refyear, l.refmonth
)
SELECT
    refyear,
    ROUND(AVG(local_price), 2) AS avg_local_price,
    ROUND(AVG(global_price), 2) AS avg_global_price,
    ROUND(AVG(price_diff), 2) AS avg_abs_diff_usd,
    ROUND(AVG(pct_diff), 2) AS avg_abs_diff_pct
FROM comparison
WHERE refYear &lt; '2025'
GROUP BY refyear
ORDER BY refyear DESC
</sql><sql name="SQL 7">-- Which three months show the highest global trade value for consumer goods?
WITH ranked AS (
    SELECT
        refYear AS year,
        refMonth AS month,
        primaryValue AS usd_value,
        DENSE_RANK() OVER (
            PARTITION BY refYear
            ORDER BY primaryValue DESC
        ) AS rn
    FROM Raw_ComTrade
	WHERE year IS NOT NULL

)
SELECT
    month,
    COUNT(*) AS times_top3_demand
FROM ranked
WHERE rn &lt;= 3
GROUP BY month
ORDER BY times_top3_demand DESC
LIMIT 3
</sql><sql name="SQL 9">-- Which months show the highest consumer demand based on global trade value by month?

SELECT 
    refMonth AS month,
    round(AVG(primaryValue),2) AS avg_usd_value
FROM Raw_ComTrade
GROUP BY month
ORDER BY avg_usd_value DESC
LIMIT 5</sql><sql name="SQL 13">-- Identify if months with highest demand (export value) also align with favorable or unfavorable global cacao prices.


WITH monthly_demand AS (
    SELECT
        refYear AS year,
        printf('%02d', refMonth) AS month,
        SUM(primaryValue) AS total_usd_exports
    FROM Raw_ComTrade
    GROUP BY refYear, refMonth
),
monthly_price AS (
    SELECT 
        substr(observation_date, -4, 4) AS year,
        printf('%02d', substr(observation_date, 1, instr(observation_date,'/')-1)) AS month,
        AVG(price_cocoa_usd_metric_ton) AS avg_global_price
    FROM Cleaned_Global_Cacao
    GROUP BY year, month
),
joined AS (
    SELECT
        d.year,
        d.month,
        d.total_usd_exports,
        p.avg_global_price
    FROM monthly_demand d
    JOIN monthly_price p
      ON d.year = p.year AND d.month = p.month
),
stats AS (
    SELECT
        AVG(total_usd_exports) AS mean_exports,
        AVG(avg_global_price) AS mean_price
    FROM joined
)
SELECT
    j.month,
    ROUND(AVG(j.total_usd_exports),0) AS avg_monthly_exports,
    ROUND(AVG(j.avg_global_price),2) AS avg_global_price,
    ROUND(
        (
            AVG( (j.total_usd_exports - s.mean_exports) * (j.avg_global_price - s.mean_price) )
        ) /
        ( (sqrt(AVG((j.total_usd_exports - s.mean_exports)*(j.total_usd_exports - s.mean_exports)))) *
          (sqrt(AVG((j.avg_global_price - s.mean_price)*(j.avg_global_price - s.mean_price)))) )
    , 2) AS corr_exports_price
FROM joined j, stats s
GROUP BY j.month
ORDER BY j.month
</sql><current_tab id="6"/></tab_sql></sqlb_project>
